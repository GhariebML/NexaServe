# Copy to .env with scripts/prepare_environment.sh. Never commit .env.
GENERIC_TIMEZONE=UTC
TZ=UTC
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=GENERATE_WITH_prepare_environment_sh
N8N_DB_NAME=n8n
N8N_DB_USER=n8n_user
N8N_DB_PASSWORD=GENERATE_WITH_prepare_environment_sh
CS_DB_NAME=customerservice
CS_DB_USER=cs_app_user
CS_DB_PASSWORD=GENERATE_WITH_prepare_environment_sh
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=GENERATE_WITH_prepare_environment_sh
N8N_USER_MANAGEMENT_JWT_SECRET=GENERATE_WITH_prepare_environment_sh
DASHBOARD_JWT_SECRET=GENERATE_WITH_prepare_environment_sh
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_METRICS=true
N8N_LOG_LEVEL=info
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text
EMBED_DIMENSION=768
OLLAMA_KEEP_ALIVE=24h
REDIS_PORT=6379
REDIS_PASSWORD=GENERATE_WITH_prepare_environment_sh
WHATSAPP_PORT=8080
DASHBOARD_PORT=8090
POSTGRES_HOST=postgres
OLLAMA_EMBED_URL=http://ollama:11434/api/embed
OLLAMA_GENERATE_URL=http://ollama:11434/api/generate
N8N_INTERNAL_URL=http://n8n:5678
N8N_WEBHOOK_URL=http://n8n:5678/webhook/customer-service
WHATSAPP_BRIDGE_URL=http://whatsapp:8080
TLS_CERT_DIR=/etc/nexaserve/tls
