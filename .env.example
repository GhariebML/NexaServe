# ==============================================================================
# Customer Service AI Automation System - Environment Configuration
# ==============================================================================

# Timezone
GENERIC_TIMEZONE=UTC
TZ=UTC

# PostgreSQL Configuration
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_root_password_here

# n8n Database (Dedicated PostgreSQL user & database)
N8N_DB_NAME=n8n
N8N_DB_USER=n8n_user
N8N_DB_PASSWORD=your_secure_n8n_db_password_here

# Customer Service Platform Database (Dedicated application user & database)
CS_DB_NAME=customerservice
CS_DB_USER=cs_app_user
CS_DB_PASSWORD=your_secure_cs_db_password_here

# n8n System Configuration
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=replace_with_a_random_32_character_encryption_key
N8N_USER_MANAGEMENT_JWT_SECRET=replace_with_a_random_jwt_secret
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_METRICS=true
N8N_LOG_LEVEL=info

# Ollama LLM Configuration
OLLAMA_PORT=11435
OLLAMA_INTERNAL_PORT=11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_KEEP_ALIVE=24h

# Redis Configuration (Session caching, rate limiting, queues)
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password_here
