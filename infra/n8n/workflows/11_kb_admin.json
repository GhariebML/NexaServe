      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, category, program, retrieval_scope, question, answer, question_ar, answer_ar, is_active FROM knowledge_base WHERE is_active = TRUE AND length($1::text) > 0 AND (question ILIKE '%' || $1::text || '%' OR answer ILIKE '%' || $1::text || '%' OR question_ar ILIKE '%' || $1::text || '%' OR answer_ar ILIKE '%' || $1::text || '%') ORDER BY id LIMIT 20;",
