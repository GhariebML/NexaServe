      "id": "n1",
      "name": "Webhook: KB Admin",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        100,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "kb-admin",
        "responseMode": "responseNode"
