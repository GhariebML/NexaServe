      "parameters": {
        "operation": "executeQuery",
        "query": "WITH ins AS (INSERT INTO knowledge_base (category, question, answer, question_ar, answer_ar, keywords, keywords_ar, program, retrieval_scope, source_attribution, is_active) SELECT COALESCE(NULLIF($1::text, ''), 'general'), $2::text, $3::text, NULLIF($4::text, ''), NULLIF($5::text, ''), '{}'::text[], '{}'::text[], CASE WHEN $6::text IN ('DEPI', 'DEBI', 'DIGILIANS', 'COMMON') THEN $6::text ELSE 'DEPI' END, NULL, 'kb-admin webhook (pending review)', FALSE WHERE length(trim($2::text)) > 0 AND length(trim($3::text)) > 0 RETURNING id, category, program, question, is_active) SELECT 'created' AS result, ins.* FROM ins UNION ALL SELECT 'rejected', NULL::int, NULL, NULL, NULL, NULL WHERE NOT EXISTS (SELECT 1 FROM ins);",
        "options": {
          "queryReplacement": "={{ [String($json.body?.category || '').trim(), String($json.body?.question || ''), String($json.body?.answer || ''), String($json.body?.question_ar || ''), String($json.body?.answer_ar || ''), String($json.body?.program || 'DEPI').trim().toUpperCase()] }}"
        }
