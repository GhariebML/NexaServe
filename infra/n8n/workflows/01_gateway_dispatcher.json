      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [1320, 380]
    },
    {
      "parameters": {
        "jsCode": "const ai = $('Call SubWF 03 - AI Intent Engine').first().json.ai_output;\nreturn [{\n  json: {\n    status: 'general',\n    intent_handled: 'general_support',\n    reply: ai?.direct_response || \"Thank you for reaching out! How can I assist you with your orders or questions today?\"\n  }\n}];"
      },
      "id": "node-route-general",
      "name": "General Support Handler",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 520]
    },
    {
      "parameters": {
        "jsCode": "const handlerResult = $input.first()?.json || {};\nconst aiContext = $('Call SubWF 03 - AI Intent Engine').first()?.json || {};\nconst norm = $('Normalize Input').first()?.json || {};\n\nconst finalReply = handlerResult.reply || \"Thank you for contacting customer service. How may we assist you?\";\nconst latency = Date.now() - (norm.start_time || Date.now());\n\nreturn [{\n  json: {\n    customer: aiContext.customer,\n    conversation: aiContext.conversation,\n    customer_message: norm.customer_message,\n    ai_output: aiContext.ai_output,\n    handler_status: handlerResult.status,\n    final_reply: finalReply,\n    latency_ms: latency\n  }\n}];"
      },
      "id": "node-assemble-response",
      "name": "Assemble Response & Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1580, 320]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "CSWF000000000007",
          "mode": "id"
        }
      },
      "id": "node-call-logger",
      "name": "Call SubWF 05 - Logger",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [1800, 320]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"success\",\n  \"customer\": {\n    \"name\": \"{{ $('Assemble Response & Metrics').first().json.customer?.full_name }}\",\n    \"phone\": \"{{ $('Assemble Response & Metrics').first().json.customer?.phone_number }}\"\n  },\n  \"conversation_id\": \"{{ $('Assemble Response & Metrics').first().json.conversation?.id }}\",\n  \"intent\": \"{{ $('Assemble Response & Metrics').first().json.ai_output?.intent }}\",\n  \"confidence\": {{ $('Assemble Response & Metrics').first().json.ai_output?.confidence || 0 }},\n  \"response\": {{ JSON.stringify($('Assemble Response & Metrics').first().json.final_reply) }},\n  \"latency_ms\": {{ $('Assemble Response & Metrics').first().json.latency_ms }}\n}",
        "options": {}
      },
