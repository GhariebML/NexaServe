      "id": "node-manual",
      "name": "Manual Test Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [160, 420]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first()?.json || {};\nconst body = input.body || input;\n\nconst customerMessage = body.message || body.customer_message || 'Hello, I want to know the status of my order ORD-1001.';\nconst phoneNumber = body.phone || body.phone_number || '+1234567890';\nconst fullName = body.name || body.full_name || 'John Doe';\nconst channel = body.channel || 'web';\n\nreturn [{\n  json: {\n    customer_message: customerMessage,\n    phone_number: phoneNumber,\n    full_name: fullName,\n    channel: channel,\n    start_time: Date.now()\n  }\n}];"
      },
      "id": "node-normalize",
      "name": "Normalize Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [380, 320]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "CSWF000000000002",
          "mode": "id"
        }
      },
      "id": "node-call-session",
      "name": "Call SubWF 02 - Session Manager",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [600, 320]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "CSWF000000000003",
          "mode": "id"
        }
      },
      "id": "node-call-ai",
      "name": "Call SubWF 03 - AI Intent Engine",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [820, 320]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": false
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.ai_output?.requires_human || $json.ai_output?.intent === 'human_escalation' }}",
                    "rightValue": true,
                    "operator": {
                      "type": "boolean",
                      "operation": "equals"
                    }
                  }
                ]
              }
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.ai_output?.intent }}",
                    "rightValue": "order_lookup",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              }
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.ai_output?.intent }}",
                    "rightValue": "faq_query",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              }
            }
          ]
        },
        "fallbackOutput": 3
      },
