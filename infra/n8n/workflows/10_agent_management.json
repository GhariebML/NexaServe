        50
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO agents (name, email, role, team) VALUES ('{{ $json.body?.name }}', '{{ $json.body?.email }}', '{{ $json.body?.role || \"tier1\" }}', 'DEPI Support') RETURNING *;",
        "credentials": {
          "postgres": {
            "id": "CS_PG_CRED_01",
            "name": "CustomerService Postgres"
          }
        }
      }
    },
    {
