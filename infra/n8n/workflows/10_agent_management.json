      "position": [
        580,
        350
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM agents WHERE status = 'available' ORDER BY RANDOM() LIMIT 1;",
        "credentials": {
          "postgres": {
            "id": "CS_PG_CRED_01",
            "name": "CustomerService Postgres"
          }
        }
      }
    },
