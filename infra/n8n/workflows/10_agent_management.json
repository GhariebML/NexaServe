        580,
        200
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE agents SET status = '{{ $json.body?.status }}', updated_at = NOW() WHERE email = '{{ $json.body?.email }}';",
        "credentials": {
          "postgres": {
            "id": "CS_PG_CRED_01",
            "name": "CustomerService Postgres"
          }
        }
      }
    },
    {
