    {
      "id": "node-agent-register",
      "name": "AGENT - Register",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        580,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "CS_PG_FINAL_01",
          "name": "CustomerService Postgres Final"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH ins AS (INSERT INTO agents (name, email, role, team) SELECT $1::text, NULLIF($2::text, ''), COALESCE(NULLIF($3::text, ''), 'tier1'), 'DEPI Support' WHERE length(trim($1::text)) > 0 ON CONFLICT (email) DO NOTHING RETURNING id, name, email, role, team, status) SELECT 'created' AS result, ins.* FROM ins UNION ALL SELECT 'rejected', NULL::uuid, NULL, NULL, NULL, NULL, NULL WHERE NOT EXISTS (SELECT 1 FROM ins);",
        "options": {
          "queryReplacement": "={{ [String($json.body?.name || '').trim(), String($json.body?.email || '').trim().toLowerCase(), String($json.body?.role || '').trim()] }}"
        }
      }
    },
    {
      "id": "node-agent-status",
      "name": "AGENT - Update Status",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        580,
        150
      ],
      "credentials": {
        "postgres": {
          "id": "CS_PG_FINAL_01",
          "name": "CustomerService Postgres Final"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH upd AS (UPDATE agents SET status = CASE WHEN $1::text IN ('available', 'busy', 'away', 'offline') THEN $1::text ELSE status END, updated_at = NOW() WHERE email = $2::text AND $1::text IN ('available', 'busy', 'away', 'offline') RETURNING id, name, email, status) SELECT 'updated' AS result, upd.* FROM upd UNION ALL SELECT 'rejected', NULL::uuid, NULL, NULL, NULL WHERE NOT EXISTS (SELECT 1 FROM upd);",
        "options": {
          "queryReplacement": "={{ [String($json.body?.status || '').trim().toLowerCase(), String($json.body?.email || '').trim().toLowerCase()] }}"
        }
      }
    },
    {
      "id": "node-agent-available",
      "name": "AGENT - Get Available",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        580,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "CS_PG_FINAL_01",
          "name": "CustomerService Postgres Final"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, name, email, role, team, status FROM agents WHERE status = 'available' ORDER BY random() LIMIT 1;",
        "options": {}
      },
      "alwaysOutputData": true
    },
    {
      "id": "node-agent-performance",
      "name": "AGENT - Performance",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        580,
        450
      ],
      "credentials": {
        "postgres": {
          "id": "CS_PG_FINAL_01",
          "name": "CustomerService Postgres Final"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT a.id, a.name, a.email, count(p.id) AS events, round(avg(p.response_time_ms)) AS avg_response_ms, max(p.created_at) AS last_event_at FROM agents a LEFT JOIN agent_performance p ON p.agent_id = a.id GROUP BY a.id, a.name, a.email ORDER BY events DESC;",
        "options": {}
      },
      "alwaysOutputData": true
    },
